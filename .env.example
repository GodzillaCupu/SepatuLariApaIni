# Database Configuration (Turso Cloud for production, or local file for offline/dev)
# For local development: file:./data/shoes.db
# For production on Vercel: libsql://lariyuk-db-[user].turso.io
TURSO_DATABASE_URL=file:./data/shoes.db
TURSO_AUTH_TOKEN=

# AI Vision Scan (opsional). Default aplikasi = BYOK: pengguna mengisi key sendiri di Pengaturan AI.
# GEMINI_API_KEY di bawah HANYA dipakai saat NODE_ENV != production (uji kamera / UI saat development).
# Jangan isi di environment production.
GEMINI_API_KEY=
